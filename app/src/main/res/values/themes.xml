<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Quadro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/quadro_background</item>
        <item name="android:colorBackground">@color/quadro_background</item>
        <item name="android:colorAccent">@color/quadro_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Quadro.Launcher">
        <!-- The system wallpaper shows through; LauncherScreen draws the user's dimming layer over it. -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
